POSTGRES_DB=seu_banco
POSTGRES_PASSWORD=sua_senha
POSTGRES_USER=nome_de_usuario
POSTGRES_PORT=porta_do_postgres

DATABASE_URL=postgresql://nome_de_usuario:sua_senha@localhost:porta_do_postgres/seu_banco

LOCALSTACK_PORT=porta_do_localstack

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_ENDPOINT=http://localhost:4566
SQS_AUTO_CREATE_QUEUES=true
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=integration-events.fifo
SQS_VISIBILITY_TIMEOUT_SECONDS=60
SQS_RETRY_BACKOFF_BASE_SECONDS=5
SQS_RETRY_BACKOFF_MAX_SECONDS=300
SQS_MAX_RECEIVE_COUNT=5
SQS_WAIT_TIME_SECONDS=20
OUTBOX_POLLING_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
PENDING_REFERENCE_REPROCESSING_ENABLED=true
PENDING_REFERENCE_POLLING_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=100
